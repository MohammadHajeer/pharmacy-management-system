{
  "name": "pharmacy-management-system",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "predev": "npx @tailwindcss/cli -i ./assets/css/input.css -o ./static/css/output.css",
    "dev": "concurrently --hide \"TW-WATCH\" --names \"DJANGO,TW-INFO,TW-WATCH\" --prefix \"[{name}]\" \"uv run python -u manage.py runserver\" \"echo Tailwind watcher is running in the background\" \"npm run dev:css\"",
    "dev:css": "npx @tailwindcss/cli -i ./assets/css/input.css -o ./static/css/output.css --watch",
    "build:css": "npx @tailwindcss/cli -i ./assets/css/input.css -o ./static/css/output.css --minify",
    "migrate": "uv run manage.py migrate",
    "makemigrations": "uv run manage.py makemigrations",
    "test": "uv run manage.py test",
    "shell": "uv run manage.py shell"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MohammadHajeer/pharmacy-management-system.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/MohammadHajeer/pharmacy-management-system/issues"
  },
  "homepage": "https://github.com/MohammadHajeer/pharmacy-management-system#readme",
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "concurrently": "^10.0.5",
    "tailwindcss": "^4.3.3"
  },
  "dependencies": {
    "chart.js": "^4.5.1"
  }
}
